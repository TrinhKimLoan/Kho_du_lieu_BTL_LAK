FROM python:3.11-slim
WORKDIR /opt/project
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/project
COPY requirements-phase11.txt /tmp/requirements-phase11.txt
RUN pip install --no-cache-dir -r /tmp/requirements-phase11.txt
COPY .streamlit /opt/project/.streamlit
COPY app /opt/project/app
COPY config /opt/project/config
COPY src /opt/project/src
COPY scripts /opt/project/scripts
COPY sql /opt/project/sql
COPY tests /opt/project/tests
COPY docs/phase2/data_contract.json /opt/project/docs/phase2/data_contract.json
EXPOSE 8501
ENTRYPOINT ["python", "-m", "streamlit", "run", "src/dashboard/app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
